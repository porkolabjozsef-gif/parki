{
  "expo": {
    "name": "Parki",
    "slug": "parki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.porki.parki",
      "infoPlist": {
        "NSMotionUsageDescription": "A Parki az autós mozgás érzékelésére használja.",
        "NSLocationWhenInUseUsageDescription": "A Parki a parkolás helyének rögzítésére használja a helyadatokat.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "A Parki a háttérben figyeli, hogy elhagytad-e a parkolás helyét.",
        "UIBackgroundModes": [
          "fetch",
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.porki.parki",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-notifications",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A Parki a háttérben figyeli, hogy elhagytad-e a parkolás helyét.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "977e0cf6-b479-48c4-807d-845cea48dbf4"
      }
    },
    "owner": "porki23",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    }
  }
}