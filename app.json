{
  "expo": {
    "name": "Parki",
    "slug": "parki",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.porki.parki",
      "infoPlist": {
        "NSMotionUsageDescription": "A Parki az aut\u00f3s mozg\u00e1s \u00e9rz\u00e9kel\u00e9s\u00e9re haszn\u00e1lja.",
        "NSLocationWhenInUseUsageDescription": "A Parki a parkol\u00e1s hely\u00e9nek r\u00f6gz\u00edt\u00e9s\u00e9re haszn\u00e1lja a helyadatokat.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "A Parki a h\u00e1tt\u00e9rben figyeli, hogy elhagytad-e a parkol\u00e1s hely\u00e9t.",
        "UIBackgroundModes": [
          "fetch",
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.porki.parki",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "versionCode": 5
    },
    "plugins": [
      "expo-notifications",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A Parki a h\u00e1tt\u00e9rben figyeli, hogy elhagytad-e a parkol\u00e1s hely\u00e9t.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "977e0cf6-b479-48c4-807d-845cea48dbf4"
      }
    },
    "owner": "porki23",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    }
  }
}