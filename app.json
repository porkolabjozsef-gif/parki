{
  "expo": {
    "name": "Parki",
    "slug": "parki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.porki.parki",
      "infoPlist": {
        "NSMotionUsageDescription": "A Parki az autós mozgás érzékelésére használja.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.porki.parki",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#00E5A0",
          "sounds": []
        }
      ],
      "./plugins/withNotificationListener"
    ],
    "extra": {
      "eas": {
        "projectId": "977e0cf6-b479-48c4-807d-845cea48dbf4"
      }
    },
    "owner": "porki23"
  }
}
